# Porta e segurança
PORT=3100
ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio
DATABASE_PATH=./data/wedeals.db

# Trava global: nada é publicado de verdade enquanto for false
PUBLISH_ENABLED=false
PUBLIC_BASE_URL=http://localhost:3100

# Shopee Affiliate Open API (obtidos no painel após aprovação)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# Mercado Livre (app no portal de desenvolvedores; busca apenas)
ML_ACCESS_TOKEN=

# Domínios extras aceitos para links de afiliados (ex.: rede parceira da SHEIN), separados por vírgula
AFFILIATE_EXTRA_DOMAINS=

# Telegram (canal complementar, opcional)
TELEGRAM_BOT_TOKEN=

# IA gratuita opcional (sem chave = templates determinísticos)
AI_PROVIDER=none          # none | ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
AI_DAILY_BUDGET_CALLS=500
