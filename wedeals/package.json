{
  "name": "wedeals",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "worker": "tsx src/scheduler/worker.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "vitest run tests/e2e",
    "demo": "node --env-file=.env.demo --no-warnings --import tsx src/server/main.ts",
    "demo:seed": "node --env-file=.env.demo --no-warnings --import tsx src/db/seed.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:install": "playwright install --only-shell chromium"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "fastify": "^5.12.8",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/qrcode": "^1.5.6",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "type": "module",
  "private": true
}
