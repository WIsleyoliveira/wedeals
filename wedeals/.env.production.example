# Copie para .env.production (fica fora do git) e preencha.

# Domínio público apontando para o servidor (registro A/AAAA). O Caddy emite o certificado HTTPS.
DOMAIN=wedeals.exemplo.com.br
# Base dos links rastreados (/r/...) que vão nas mensagens dos grupos. Use o mesmo domínio, com https.
PUBLIC_BASE_URL=https://wedeals.exemplo.com.br

# Gere com: openssl rand -base64 36
ADMIN_TOKEN=

# Trava global: nada é publicado de verdade enquanto for false
PUBLISH_ENABLED=false

# Credenciais (deixe vazio até a WAPE fornecer)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
ML_ACCESS_TOKEN=
AFFILIATE_EXTRA_DOMAINS=
TELEGRAM_BOT_TOKEN=

AI_PROVIDER=none
AI_DAILY_BUDGET_CALLS=500

# --- Backup externo (opcional, recomendado) -------------------------------------------
# Qualquer armazenamento compatível com S3: Cloudflare R2, Backblaze B2, AWS S3.
# Use uma chave com permissão só de escrita nesse bucket. Sem estas variáveis, o backup fica só no servidor.
#   R2:  BACKUP_S3_ENDPOINT=https://<ID_DA_CONTA>.r2.cloudflarestorage.com   BACKUP_S3_REGION=auto
#   B2:  BACKUP_S3_ENDPOINT=https://s3.<regiao>.backblazeb2.com             BACKUP_S3_REGION=<regiao>
#   S3:  BACKUP_S3_ENDPOINT=https://s3.<regiao>.amazonaws.com               BACKUP_S3_REGION=<regiao>
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=wedeals/

# --- Alertas de falha (opcional, recomendado) -----------------------------------------
# Telegram: chat do administrador (não é um grupo de ofertas). Usa TELEGRAM_BOT_TOKEN se o abaixo ficar vazio.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Webhook HTTPS (Discord, Slack, Google Chat, ntfy…): recebe JSON com "text" e "content".
ALERT_WEBHOOK_URL=
# Reenvia um alerta que continua ativo depois de N horas
ALERT_REPEAT_HOURS=6

