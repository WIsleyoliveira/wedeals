# Copie para .env.production (fica fora do git) e preencha.

# Domínio público apontando para o servidor (registro A/AAAA). O Caddy emite o certificado HTTPS.
DOMAIN=wedeals.exemplo.com.br
# Base dos links rastreados (/r/...) que vão nas mensagens dos grupos. Use o mesmo domínio, com https.
PUBLIC_BASE_URL=https://wedeals.exemplo.com.br

# Gere com: openssl rand -base64 36
ADMIN_TOKEN=

# Trava global: nada é publicado de verdade enquanto for false
PUBLISH_ENABLED=false

# Credenciais (deixe vazio até a WAPE fornecer)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
ML_ACCESS_TOKEN=
AFFILIATE_EXTRA_DOMAINS=
TELEGRAM_BOT_TOKEN=

AI_PROVIDER=none
AI_DAILY_BUDGET_CALLS=500
